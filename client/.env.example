# =========================================================
# ANVESHANA CLIENT FRONTEND ENVIRONMENT VARIABLES (.env)
# =========================================================

# Backend Express REST API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Real-Time Telemetry Socket.io WebSocket URL
VITE_SOCKET_URL=http://localhost:5000

# Python FastAPI ML Microservice URL
VITE_ML_SERVICE_URL=http://localhost:8000

# 🗺️ GIS Map Tile Provider (Clean, No Watermarks!)
# Option 1: OpenStreetMap Standard (Clean, No Watermark)
VITE_MAP_TILE_LAYER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Option 2: Esri World Topo Map (Clean GIS Topographic Map, No Watermark)
# VITE_MAP_TILE_LAYER=https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}

# Master Admin Passcode
VITE_MASTER_ADMIN_PASSCODE=1234
